# Copy to server/.env (ignored by git) and fill in. Never commit real keys.
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=
# Device for local CrisperWhisper: mps (Apple GPU, default) or cpu.
SPEAKUP_CRISPER_DEVICE=mps

# Analysis server (M1). Run `uv run speakup-server`; it refuses to start without SPEAKUP_API_TOKEN.
# Generate a token: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SPEAKUP_API_TOKEN=
# Coaching and question generation. Without it coaching is unavailable and questions come from the bank.
ANTHROPIC_API_KEY=
# Database, audio and profile.md. Relative paths are relative to the repository. Default: data/server
SPEAKUP_DATA_DIR=
# Engine name from stt/registry.py. Default: crisperwhisper (an alias for crisper-large)
SPEAKUP_STT_ENGINE=
# Claude model for coaching and questions. Default: claude-opus-5-5
SPEAKUP_COACH_MODEL=
# Local port behind `tailscale serve`. Default: 8765
SPEAKUP_PORT=
