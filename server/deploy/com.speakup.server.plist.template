<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job for the SpeakUp analysis server on the Mac mini. Full instructions: docs/server.md.

  Replace __REPO_DIR__ with the absolute path of the repository checkout used for serving, and
  __HOME__ with your home directory, then save as ~/Library/LaunchAgents/com.speakup.server.plist.

  Two things decide whether this job works at all:

  1. macOS privacy (TCC). A job started by launchd cannot read files under ~/Documents,
     ~/Desktop or ~/Downloads unless the python binary has Full Disk Access, and it crash-loops
     with "Operation not permitted". So the checkout named by __REPO_DIR__ and the data
     directory below must live OUTSIDE those folders. Suggested: a checkout at ~/speakup and
     data in ~/Library/Application Support/SpeakUp. The alternative is granting Full Disk Access
     to the resolved python binary (server/.venv/bin/python resolves to a uv-managed python
     under ~/.local/share/uv/python/), which survives only until uv replaces that python.

  2. A LaunchAgent runs only while its user is logged in to the desktop. A Mac mini that
     reboots needs automatic login (System Settings > Users & Groups; FileVault blocks it), or
     this job must become a LaunchDaemon in /Library/LaunchDaemons with a UserName key naming
     your user (and root ownership of the file, mode 644).

  The token and API keys are read from __REPO_DIR__/server/.env; do not put them in this file.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.speakup.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REPO_DIR__/server/.venv/bin/speakup-server</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_DIR__/server</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- ffmpeg lives in Homebrew's prefix, which launchd's default PATH lacks. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <!-- Outside Documents, Desktop and Downloads (see above). -->
    <key>SPEAKUP_DATA_DIR</key>
    <string>__HOME__/Library/Application Support/SpeakUp</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Wait before a restart so a crash loop does not spin. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/speakup-server.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/speakup-server.log</string>
</dict>
</plist>
